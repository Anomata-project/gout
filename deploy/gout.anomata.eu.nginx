# gout's web preview (deploy/deploy-web.sh installs it; certbot adds https to it)
server {
    listen 80;
    listen [::]:80;
    server_name gout.anomata.eu;

    client_max_body_size 21m;          # the preview takes files up to 20 MB

    location / {
        proxy_pass http://127.0.0.1:8321;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # set, not appended: gout reads the last address
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;   # uploads go straight to gout, which refuses a too-large one by its size
        proxy_read_timeout 300s;       # a render can take a while
        proxy_send_timeout 300s;
    }
}
